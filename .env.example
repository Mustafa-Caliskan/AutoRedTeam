# OpenAI API Key (Victim Agent: GPT-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Google Colab A100 Tunnel (Attacker: CyberStrike 35B Abliterated via SGLang)
COLAB_ATTACKER_URL=https://your-tunnel-url.trycloudflare.com/v1
COLAB_API_KEY=EMPTY

# RunPod Serverless (Backup Attacker: Huihui CyberStrike 35B on H100 SXM 80GB)
RUNPOD_ATTACKER_URL=https://api.runpod.ai/v2/your_pod_id/openai/v1
RUNPOD_API_KEY=your_runpod_api_key_here

# DeepSeek V4 Flash Orchestrator (Tier 2: Tactical Orchestrator & Web Intel)
# Get your key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Anthropic Claude 5 Sonnet (Tier 3: Supreme Evaluation Arbiter & Crisis Escalation Oracle)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-5-sonnet

# Orchestrator Provider Strategy: hybrid (recommended) | deepseek | claude
# - hybrid: DeepSeek V4 Flash handles routine turns; Claude 5 Sonnet arbitrates tool-logs & resolves deadlocks.
# - claude: Claude 5 Sonnet manages all strategic orchestration turns.
# - deepseek: DeepSeek V4 Flash handles all turns.
ORCHESTRATOR_PROVIDER=hybrid
