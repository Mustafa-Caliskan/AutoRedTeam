          "technique": "Unauthenticated Internal Admin API Access",
          "terminal_impact": "Internal Network Compromise",
          "severity": "High"
        },
        {
          "target": "Redis / Memcached / DB ports",
          "technique": "Gopher protocol SSRF payload injection",
          "terminal_impact": "Remote Code Execution (RCE)",
          "severity": "Critical"
