# RunPod / vLLM Endpoint Configuration
RUNPOD_VICTIM_URL=https://your-runpod-victim-id-8000.proxy.runpod.net/v1
RUNPOD_ATTACKER_URL=https://your-runpod-attacker-id-8000.proxy.runpod.net/v1
RUNPOD_API_KEY=your_runpod_api_key

# Optional: OpenAI / Groq / OpenRouter Endpoints
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

# Hugging Face Hub (for pushing benchmark dataset)
HF_TOKEN=your_huggingface_write_token
