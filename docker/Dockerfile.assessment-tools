# AutoRedTeam — Security Assessment Tools Container
#
# Bu image, güvenlik değerlendirme asistanının kullandığı tarama araçlarını
# barındırır. Yalnızca YETKİLİ, eğitim amaçlı testler içindir (OWASP Juice Shop).
#
# Kullanım: docker compose -f docker/docker-compose.yml up -d --build
# Araçlar bu konteyner içinde çalışır; host'taki assessment_tools.py bunları
# "docker exec assessment-tools <komut>" ile çağırır.

FROM kalilinux/kali-rolling:latest

# Non-interactive apt
ENV DEBIAN_FRONTEND=noninteractive

# Temel paketler + tarama araçları (apt ile kurulabilenler)
# NOT: Kali'de her paket onlarca bağımlılık çeker. Build süresini makul
# tutmak için yalnızca kritik araçlar kurulur; ağır/opsiyonel paketler
# (wafw00f, smbmap, nfs-common, whois) bilinçli olarak dışarıda bırakılmıştır.
RUN apt-get update && apt-get install -y --no-install-recommends \
    nmap \
    gobuster \
    nikto \
    whatweb \
    sqlmap \
    exploitdb \
    hydra \
    ffuf \
    enum4linux \
    smbclient \
    git \
    curl \
    unzip \
    ca-certificates \
    python3 \
    python3-pip \
    bsdmainutils \
    dnsutils \
    netcat-openbsd \
    sshpass \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

# nuclei (ProjectDiscovery) — 5000+ CVE/misconfig şablonu ile otonom zafiyet taraması
# NOT: nuclei indirmesi GitHub release'inden yapilir ve bazi aglarda askida
# kalabiliyor. Bu yuzden build'i bloklamamasi icin OPSIYONEL hale getirildi;
# basarisiz olursa build devam eder. Kurulum basariliysa recon_engine onu kullanir.
RUN (curl -fsSL --max-time 120 \
        https://github.com/projectdiscovery/nuclei/releases/download/v3.3.7/nuclei_3.3.7_linux_amd64.zip \
        -o /tmp/nuclei.zip \
     && unzip -o /tmp/nuclei.zip -d /usr/local/bin/ \
     && chmod +x /usr/local/bin/nuclei \
     && rm -f /tmp/nuclei.zip) || echo "[WARN] nuclei kurulumu atlandi (indirme basarisiz)"

# linpeas (post-exploitation otomatik yetki yükseltme taraması)
RUN mkdir -p /opt/peass \
    && curl -fsSL https://github.com/peass-ng/PEASS-ng/releases/latest/download/linpeas.sh \
       -o /opt/peass/linpeas.sh \
    && chmod +x /opt/peass/linpeas.sh \
    && ln -sf /opt/peass/linpeas.sh /usr/local/bin/linpeas || true

# testssl.sh (apt paketi yok, GitHub'dan klonlanır)
RUN git clone --depth 1 https://github.com/drwetter/testssl.sh.git /opt/testssl.sh \
    && chmod +x /opt/testssl.sh/testssl.sh \
    && ln -s /opt/testssl.sh/testssl.sh /usr/local/bin/testssl.sh

# gobuster için wordlist (SecLists common.txt — GitHub'dan indirilir)
RUN mkdir -p /usr/share/wordlists/dirb \
    && curl -fsSL https://raw.githubusercontent.com/danielmiessler/SecLists/master/Discovery/Web-Content/common.txt \
       -o /usr/share/wordlists/dirb/common.txt \
    && wc -l /usr/share/wordlists/dirb/common.txt

# Araçların PATH'te olduğunu doğrula
RUN which nmap gobuster nikto whatweb sqlmap testssl.sh searchsploit sshpass nc hydra ffuf enum4linux smbclient || true
RUN which nuclei linpeas || true

# Exploit betikleri /opt/art/exploits/ altina docker-compose volume ile
# bind-mount edilir (bkz. docker-compose.yml). Bu sayede betik guncellemeleri
# icin imaji yeniden build etmeye gerek kalmaz. Dizin yine de olusturulur ki
# volume olmadan da konteyner calissin.
RUN mkdir -p /opt/art/exploits

# Varsayılan çalışma dizini
WORKDIR /workspace

# Konteyner ayakta kalsın (interaktif docker exec için)
CMD ["sleep", "infinity"]
